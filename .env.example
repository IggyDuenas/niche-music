# Where the app is served from. Must match your Spotify redirect URI exactly.
# Spotify rejects "localhost" — use 127.0.0.1 in development.
APP_URL=http://127.0.0.1:3000

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Spotify (optional, but this is the main way in) ---
# From https://developer.spotify.com/dashboard — add a redirect URI of
# $APP_URL/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Reference data (recommended) ---
# Free, instant, no approval: https://www.last.fm/api/account/create
# Without it the app falls back to Deezer, which needs no key but gives a
# coarser signal.
LASTFM_API_KEY=

# --- Apple Music (optional, needs a paid Apple Developer account) ---
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of your MusicKit .p8 file. Keep the BEGIN/END lines. In a .env file
# put it on one line with literal \n between the lines.
APPLE_PRIVATE_KEY=
